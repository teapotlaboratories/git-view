#!/bin/sh
# gitview-bridgectl — manage the GitView bridge systemd service.
#
# Read-only actions (status/health/version/config) run as you; privileged actions
# (pair/start/stop/restart/logs/devices/revoke) re-exec via sudo when you are not root.
set -eu

SERVICE="gitview-bridge"
CONFIG="${GITVIEW_CONFIG:-/etc/gitview-bridge/config.yaml}"
# pair/devices/revoke ask the BRIDGE over its unix control socket (ADR-036); this script no longer reads
# or writes the token store. It carries no credential and needs none: it ships in the same package, runs
# as root or the run-user, and already drives systemctl and journalctl — authenticating to a service on
# the same box whose state file it could write anyway would be theatre. Since ADR-035 the store keeps only
# sha256 hashes, so there is no usable token on disk to call the HTTP API with in any case.
SUDO=""
# GITVIEW_SUDO lets the test suite drive this script against a socket it already owns; unset it and the
# behaviour is unchanged (sudo when not root).
[ "$(id -u)" -eq 0 ] || SUDO="${GITVIEW_SUDO-sudo}"

# --- config-derived connection info (defaults if unreadable) ---
_port() { grep -oE '^[[:space:]]*port:[[:space:]]*[0-9]+' "$CONFIG" 2>/dev/null | grep -oE '[0-9]+' | tail -1; }
_bind() { grep -oE '^[[:space:]]*bind:[[:space:]]*[^[:space:]#]+' "$CONFIG" 2>/dev/null | awk '{print $2}' | tail -1; }
port() { p="$(_port)"; echo "${p:-8787}"; }
# 0.0.0.0 isn't dialable — hit loopback.
host() { b="$(_bind)"; b="${b:-127.0.0.1}"; [ "$b" = "0.0.0.0" ] && b="127.0.0.1"; echo "$b"; }
base() { echo "http://$(host):$(port)"; }
# Where the bridge listens for host admin commands (ADR-036).
#
# GITVIEW_CONTROL_SOCKET is an explicit override, and the test suite REQUIRES it rather than leaning on the
# config parse. The fallback below is right for an operator and dangerous for a test: a config without a
# `controlSocket:` line silently retargets whichever bridge is running on this host, so `pair` would rotate
# a live bridge's pairing code on every test run and `revoke` would do worse.
ctl_socket() {
  if [ -n "${GITVIEW_CONTROL_SOCKET:-}" ]; then echo "$GITVIEW_CONTROL_SOCKET"; return; fi
  f="$($SUDO grep -oE '^[[:space:]]*controlSocket:[[:space:]]*[^[:space:]#]+' "$CONFIG" 2>/dev/null | awk '{print $2}' | tail -1)"
  echo "${f:-/run/gitview-bridge/control.sock}"
}

# Send one JSON request to the control socket and print the reply.
#
# The reachability check lives HERE, inside the privileged client, and not in the shell around it. It used
# to be a plain `[ -S "$SOCK" ]` run as *you* — but the runtime directory is 0700 owned by the service
# user, so on a stock install an operator cannot stat inside it and every command reported "bridge is not
# running" while the bridge was running fine and the sudo'd line right below it would have connected.
# ENOENT/ECONNREFUSED from the connect is the same check made by whoever can actually see the socket.
ctl_send() {
  printf '%s\n' "$1" | $SUDO env GV_SOCK="$(ctl_socket)" "${GITVIEW_NODE:-node}" -e '
    var net = require("net"), sock = process.env.GV_SOCK, out = "", req = "";
    process.stdin.on("data", function (c) { req += c; }).on("end", function () {
      var c = net.connect(sock);
      c.on("error", function (e) {
        if (e.code === "ENOENT" || e.code === "ECONNREFUSED") {
          console.error("bridge is not running (no control socket at " + sock + ").");
          console.error("start it with: gitview-bridgectl start");
        } else if (e.code === "EACCES") {
          console.error("cannot open " + sock + ": permission denied.");
          console.error("run this as root, or as the user the bridge runs as.");
        } else {
          console.error("cannot reach the bridge: " + e.message);
        }
        process.exit(1);
      });
      c.setEncoding("utf8");
      c.on("data", function (d) { out += d; });
      c.on("end", function () {
        var r; try { r = JSON.parse(out); } catch (e) { console.error("bad reply from bridge"); process.exit(1); }
        if (!r.ok) { console.error(r.error); process.exit(1); }
        if (r.cmd === "pair") {
          console.log("Pairing code (valid ~" + Math.round(r.expiresInSeconds / 60) + " min):  " + r.code);
          return;
        }
        if (r.cmd === "revoke") {
          // Say how many credentials went: `revoke legacy` clears the whole pre-0.1.8 bucket in one
          // irreversible call, and "Revoked legacy." alone tells the operator nothing about its size.
          var what = r.removed === 1 ? "1 credential" : r.removed + " credentials";
          console.log("Revoked " + r.id + " — " + what + ", " + r.connectionsClosed + " connection(s) closed.");
          return;
        }
        if (!r.devices.length) { console.log("No devices paired."); return; }
        function ago(iso) {
          if (!iso) return "-";
          var s = Math.floor((Date.now() - Date.parse(iso)) / 1000);
          if (!isFinite(s)) return "-";
          if (s < 60) return "just now";
          if (s < 3600) return Math.floor(s / 60) + "m ago";
          if (s < 86400) return Math.floor(s / 3600) + "h ago";
          return Math.floor(s / 86400) + "d ago";
        }
        var head = ["ID", "NAME", "CONNECTED", "LAST SEEN"];
        var rows = r.devices.map(function (d) {
          return [d.id, d.label, d.connected ? "yes" : "no", ago(d.lastSeenAt)];
        });
        var w = head.map(function (h, i) {
          return rows.reduce(function (m, x) { return Math.max(m, String(x[i]).length); }, h.length);
        });
        function line(x) { return String(x[0]).padEnd(w[0]) + "  " + String(x[1]).padEnd(w[1]) + "  " + String(x[2]).padEnd(w[2]) + "  " + x[3]; }
        console.log(line(head));
        rows.forEach(function (x) { console.log(line(x)); });
      });
      c.end(req);
    });'
}

usage() {
  cat <<EOF
gitview-bridgectl — manage the GitView bridge service

Usage: gitview-bridgectl <command>

  status            service state + bound address + version + /v1/health
  pair              mint & print a FRESH pairing code (nothing else changes)
  devices           list paired devices (id, name, connected, last seen)
  revoke <id>       revoke a device by id ("legacy" drops all pre-0.1.8 tokens)
  health            GET /v1/health (JSON)
  start|stop|restart
  logs [-f]         journalctl for the service (-f follows)
  config            print the config path
  version           installed bridge version
  help              this text

Config: $CONFIG   (edit with: sudo \$EDITOR $CONFIG, then: gitview-bridgectl restart)
EOF
}

cmd="${1:-status}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
  status)
    $SUDO systemctl status "$SERVICE" --no-pager --lines=0 || true
    echo
    echo "  bind:    $(_bind 2>/dev/null || echo '?'):$(port)"
    echo "  base:    $(base)"
    echo "  version: $(grep -oE '\"version\"[^,]*' /opt/gitview-bridge/package.json 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' || echo '?')"
    printf '  health:  '
    curl -fsS --max-time 3 "$(base)/v1/health" 2>/dev/null || echo "unreachable"
    echo
    ;;
  pair)
    # Ask the bridge for a code and read it from the REPLY. This used to `systemctl reload` and then
    # grep journalctl for the line it had just caused to be printed — fragile, and it depended on the
    # log format. It also no longer disturbs the device store: a signal could not say which of the two
    # jobs was wanted, so revoking used to rotate a pending code and vice versa.
    ctl_send '{"cmd":"pair"}'
    ;;
  devices|revoke)
    # ADR-036: ask the bridge over its unix socket instead of reading and rewriting tokens.json.
    # The bridge is the single writer, so there is no race to lose, no ownership to get wrong, and the
    # reply says what actually happened rather than the CLI assuming it worked.
    if [ "$cmd" = "revoke" ]; then
      ID="${1:?usage: gitview-bridgectl revoke <id>   (see: gitview-bridgectl devices)}"
      # JSON-encode the id rather than splicing it into a string: an id with a quote in it would
      # otherwise produce a malformed request. Unprivileged on purpose — it only touches argv.
      REQ="$(GV_ID="$ID" "${GITVIEW_NODE:-node}" -e 'process.stdout.write(JSON.stringify({cmd:"revoke",id:process.env.GV_ID}))')"
    else
      REQ='{"cmd":"devices"}'
    fi
    ctl_send "$REQ"
    ;;

  health)  curl -fsS "$(base)/v1/health" 2>/dev/null && echo || { echo "unreachable"; exit 1; } ;;
  start|stop|restart) $SUDO systemctl "$cmd" "$SERVICE"; echo "$SERVICE $cmd: done" ;;
  logs)
    if [ "${1:-}" = "-f" ]; then $SUDO journalctl -u "$SERVICE" -f
    else $SUDO journalctl -u "$SERVICE" -n 100 --no-pager; fi ;;
  config)  echo "$CONFIG" ;;
  version) grep -oE '\"version\"[^,]*' /opt/gitview-bridge/package.json 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' || { echo "unknown"; exit 1; } ;;
  -h|--help|help) usage ;;
  *) echo "unknown command: $cmd" >&2; echo; usage; exit 1 ;;
esac
